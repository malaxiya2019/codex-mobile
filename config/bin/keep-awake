#!/bin/bash

# 获取唤醒锁
if ! termux-wake-lock 2>/dev/null; then
    echo "❌ 无法获取唤醒锁，请检查 termux-api 是否安装"
    exit 1
fi

echo "🔋 CPU 保活已开启"
echo "   按 Ctrl+C 退出（自动释放锁）"

cleanup() {
    trap - SIGINT SIGTERM EXIT # 解除绑定，防止递归
    echo ""
    echo "🔋 释放唤醒锁..."
    termux-wake-unlock 2>/dev/null
    exit 0
}
trap cleanup SIGINT SIGTERM EXIT

# 保持进程运行
tail -f /dev/null
