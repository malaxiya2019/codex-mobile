# ChinaCode - 预装配置
export PATH="$HOME/.local/bin:$PATH"

# 别名
alias c='codex'
alias cy='CODEX_SANDBOX_NETWORK_DISABLED=0 codex --dangerously-bypass-approvals-and-sandbox'
alias cs='codex --ask-for-approval on-request'

# cyo = YOLO + 自动恢复 + 中文模式
cyo() {
    echo "[cyo] 启动 ChinaCode..."
    
    if ! curl -s -f --connect-timeout 2 http://127.0.0.1:8788/v1/models > /dev/null 2>&1; then
        echo "[cyo] 启动 mimo2codex..."
        nohup mimo2codex --model ds --port 8788 > ~/mimo2codex.log 2>&1 &
        sleep 2
    fi
    
    local ZH_PROMPT="以后所有自然语言使用简体中文回答。
分析、计划、修改说明、总结均使用中文。
代码、命令、文件路径、日志保持原文。"
    
    CODEX_SANDBOX_NETWORK_DISABLED=0 \
    codex --dangerously-bypass-approvals-and-sandbox \
    "$ZH_PROMPT" "$@"
}

# 状态检查
alias st='ps aux | grep -E "mimo2codex|codex" | grep -v grep'

echo "✅ ChinaCode 已就绪！输入 cyo --zh 启动"
