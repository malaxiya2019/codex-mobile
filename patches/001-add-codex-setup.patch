+    /**
+     * 在首次启动时复制预装配置到 home 目录
+     */
+    private static void installCodexConfig(TermuxService service) {
+        final Context context = service;
+        final File homeDir = new File(FileUtils.getCanonicalHome(context));
+        final AssetManager am = context.getAssets();
+        final String[] assetDirs = {"codex-home", "codex-termux", "codex-bin"};
+        
+        try {
+            // 复制 codex-home → ~/
+            String[] homeFiles = am.list("codex-home");
+            if (homeFiles != null && homeFiles.length > 0) {
+                for (String f : homeFiles) {
+                    FileUtils.copyAsset(am, "codex-home/" + f, new File(homeDir, f));
+                }
+            }
+            
+            // 复制 codex-termux → ~/.termux/
+            File termuxDir = new File(homeDir, ".termux");
+            if (!termuxDir.exists()) termuxDir.mkdirs();
+            String[] termuxFiles = am.list("codex-termux");
+            if (termuxFiles != null) {
+                for (String f : termuxFiles) {
+                    FileUtils.copyAsset(am, "codex-termux/" + f, new File(termuxDir, f));
+                }
+            }
+            
+            // 复制 codex-bin → ~/.local/bin/
+            File binDir = new File(homeDir, ".local/bin");
+            if (!binDir.exists()) binDir.mkdirs();
+            String[] binFiles = am.list("codex-bin");
+            if (binFiles != null) {
+                for (String f : binFiles) {
+                    FileUtils.copyAsset(am, "codex-bin/" + f, new File(binDir, f));
+                }
+            }
+            
+            // 设置脚本可执行权限
+            for (File f : binDir.listFiles()) {
+                f.setExecutable(true, false);
+            }
+        } catch (Exception e) {
+            // 静默失败，不影响 Termux 正常启动
+        }
+    }
+
     /** Called when onCreate() is called on the TermuxService. */
     public static void onCreate(TermuxService service) {
         setupTermuxDataDir(service);
         setupShellEnvironment(service);
+        // 安装 Codex 预装配置
+        installCodexConfig(service);
